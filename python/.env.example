# ─────────────────────────────────────────
# Copy this file to .env and fill in values
# cp .env.example .env
# ─────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=ytsearch
POSTGRES_PASSWORD=ytsearch_dev
POSTGRES_DB=ytsearch
DATABASE_URL=postgresql://ytsearch:ytsearch_dev@localhost:5432/ytsearch

# Redis
REDIS_PASSWORD=redis_dev
REDIS_URL=redis://:redis_dev@localhost:6379/0

# Kafka
# Use port 9094 when connecting from host machine (Python/Java running locally)
# Use port 9092 when connecting from inside Docker network
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# YouTube Data API
YOUTUBE_API_KEY=AIzaSyC-gn1Lal_jW90RDC4K_M6eoxMcCfofbc8
YOUTUBE_COOKIES_PATH=cookies.txt

# Python Embedding gRPC Service
EMBEDDING_GRPC_HOST=localhost
EMBEDDING_GRPC_PORT=50051

# Java Spring Boot
SPRING_PORT=8080

# Stripe (Billing)
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# JWT
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7