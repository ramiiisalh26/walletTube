# Copy this file to .env.local

# Base URL of the YTSearch FastAPI backend (api.main:app).
# Must be reachable from the browser. Default dev port is 8080.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Master switch for the upgrade / pricing UI. Keep "false" until ready to charge;
# must match billing_enabled in python/config.py.
NEXT_PUBLIC_BILLING_ENABLED=false

# Stripe price id for the Pro plan (from your Stripe dashboard).
# Same value as stripe_pro_price_id in python/.env. Leave blank until set up.
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
